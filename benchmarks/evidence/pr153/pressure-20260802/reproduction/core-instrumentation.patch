diff --git a/vllm/v1/kv_offload/trace.py b/vllm/v1/kv_offload/trace.py
new file mode 100644
index 000000000..9afe23ab8
--- /dev/null
+++ b/vllm/v1/kv_offload/trace.py
@@ -0,0 +1,47 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Opt-in structured trace events for KV transfer-path profiling."""
+
+from __future__ import annotations
+
+import json
+import os
+import time
+from pathlib import Path
+from typing import Any
+
+from vllm import envs
+
+
+def emit_transfer_path_event(
+    role: str,
+    request_id: str,
+    event: str,
+    **fields: Any,
+) -> None:
+    """Append one event to a process-local trace file when tracing is enabled."""
+    trace_dir_value = envs.VLLM_KV_TRANSFER_TRACE_DIR
+    if trace_dir_value is None:
+        return
+    trace_dir = Path(trace_dir_value)
+    if not trace_dir.is_absolute():
+        raise ValueError("VLLM_KV_TRANSFER_TRACE_DIR must be an absolute path")
+    trace_dir.mkdir(parents=True, exist_ok=True)
+    payload = {
+        "schema_version": 1,
+        "role": role,
+        "pid": os.getpid(),
+        "request_id": request_id,
+        "event": event,
+        "timestamp_ns": time.monotonic_ns(),
+        **fields,
+    }
+    line = (json.dumps(payload, separators=(",", ":"), sort_keys=True) + "\n").encode()
+    path = trace_dir / f"transfer-events-{role}-{os.getpid()}.jsonl"
+    descriptor = os.open(path, os.O_APPEND | os.O_CREAT | os.O_WRONLY, 0o644)
+    try:
+        written = os.write(descriptor, line)
+        if written != len(line):
+            raise OSError(f"short trace write: expected {len(line)}, wrote {written}")
+    finally:
+        os.close(descriptor)
