+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from vllm.v1.kv_offload.trace import emit_transfer_path_event
+
+
+def test_trace_is_disabled_by_default(monkeypatch: pytest.MonkeyPatch, tmp_path: Path):
+    monkeypatch.delenv("VLLM_KV_TRANSFER_TRACE_DIR", raising=False)
+    emit_transfer_path_event("scheduler", "request-1", "preempt")
+    assert list(tmp_path.iterdir()) == []
+
+
+def test_trace_writes_process_local_jsonl(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+):
+    monkeypatch.setenv("VLLM_KV_TRANSFER_TRACE_DIR", str(tmp_path))
+    emit_transfer_path_event(
+        "worker",
+        "request-1",
+        "transfer_done",
+        job_id="7",
+        direction="h2d",
+        bytes=4096,
+    )
+    (trace_path,) = tuple(tmp_path.glob("transfer-events-worker-*.jsonl"))
+    row = json.loads(trace_path.read_text(encoding="utf-8"))
+    assert row["request_id"] == "request-1"
+    assert row["event"] == "transfer_done"
+    assert row["direction"] == "h2d"
+    assert row["bytes"] == 4096
+    assert row["timestamp_ns"] > 0
+
+
+def test_trace_requires_absolute_directory(monkeypatch: pytest.MonkeyPatch):
+    monkeypatch.setenv("VLLM_KV_TRANSFER_TRACE_DIR", "relative")
+    with pytest.raises(ValueError, match="absolute"):
+        emit_transfer_path_event("scheduler", "request-1", "preempt")
