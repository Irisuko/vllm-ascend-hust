+from vllm.benchmarks.datasets import datasets as datasets_module
+
+
+def test_prefix_repetition_assigns_stable_request_ids(monkeypatch) -> None:
+    class FakeTokenizer:
+        vocab_size = 128
+
+        @staticmethod
+        def decode(token_ids: list[int]) -> str:
+            return ",".join(map(str, token_ids))
+
+    monkeypatch.setattr(
+        datasets_module,
+        "gen_prompt_decode_to_target_len",
+        lambda tokenizer, token_sequence, target_token_len, add_special_tokens: (
+            "",
+            token_sequence,
+            0,
+        ),
+    )
+    requests = PrefixRepetitionRandomDataset(random_seed=0).sample(
+        tokenizer=FakeTokenizer(),
+        num_requests=4,
+        prefix_len=4,
+        suffix_len=2,
+        num_prefixes=2,
+        output_len=2,
+        request_id_prefix="pilot-",
+    )
+
+    assert sorted(request.request_id for request in requests) == [
+        "pilot-0",
+        "pilot-1",
+        "pilot-2",
+        "pilot-3",
+    ]
 
 
